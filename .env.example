# =============================================================================
# .env.example  -  copy this to .env and fill in real values
#
#   cp .env.example .env          (or just copy/rename it in Explorer)
#
# docker-compose.yml loads .env automatically from this same folder - you
# never pass these on the command line. .env is gitignored (see .gitignore)
# so your real secrets never get committed, only this template does.
# =============================================================================

# -----------------------------------------------------------------------
# SHARED ACROSS EVERY SERVICE
#
# The one secret that lets User Service issue a JWT at login and every
# OTHER service verify it's genuine, without a network call back to User
# Service (see any service's app/security.py for the full explanation).
# CLASS PROJECT SIMPLIFICATION, STATED HONESTLY: a real product would use
# per-service keys and short-lived tokens, not one shared symmetric secret.
# Generate a real one instead of using the example below:
#   openssl rand -hex 32          (Git Bash / macOS / Linux)
#   [System.Guid]::NewGuid().ToString() + [System.Guid]::NewGuid().ToString()   (PowerShell, less ideal but fine for a class demo)
# -----------------------------------------------------------------------
GLOBETROTTER_JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that become admins the moment they register or
# next log in (see services/user-service/app/routers/auth.py). Leave
# empty and nobody is an admin - you can still set this later and log
# back in to become one.
ADMIN_EMAILS=admin@example.cm

# -----------------------------------------------------------------------
# OPTIONAL: real street routing (Itinerary Service)
#
# Without this, routes fall back to a straight-line estimate and say so
# on screen - nothing breaks. Free key: https://openrouteservice.org/dev/#/signup
# -----------------------------------------------------------------------
ORS_API_KEY=

# -----------------------------------------------------------------------
# OPTIONAL: Google Sign-In
#
# Without this, the "Continue with Google" button on the login screen
# quietly doesn't render (see Login.jsx) - email/password still works
# fully either way. A Client ID is a public IDENTIFIER, not a secret - see
# the README for how to create a free one in Google Cloud Console (no
# billing tier for basic sign-in).
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------
# SELF-HOSTED JITSI (audio/video calls)
#
# JICOFO_COMPONENT_SECRET, JICOFO_AUTH_PASSWORD and JVB_AUTH_PASSWORD are
# how Jitsi's OWN internal pieces (web/prosody/jicofo/jvb) authenticate to
# EACH OTHER - not something a traveller ever sees or types. Generate real
# random values for each (three DIFFERENT values, not the same one three
# times):
#   openssl rand -hex 16
# -----------------------------------------------------------------------
JICOFO_COMPONENT_SECRET=change-me
JICOFO_AUTH_PASSWORD=change-me-too
JVB_AUTH_PASSWORD=change-me-as-well

# The address Jitsi tells browsers to load the meeting page from, AND
# (baked into the frontend repo at build time as VITE_JITSI_URL - set
# this when building the separate frontend repo) the address the
# frontend opens when you tap "Join call". This MUST be an https://
# address - see the long
# comment on jitsi-web's environment block in docker-compose.yml for why
# (short version: browsers block camera/mic on anything that isn't HTTPS
# or the literal hostname "localhost", and Jitsi's own config template
# silently breaks call signaling if this doesn't start with "https://").
#
# LOCAL / NO DOMAIN (the default - nothing else to configure): Jitsi
# generates its own self-signed certificate automatically on first start.
# Calls work, but the FIRST time anyone opens the call tab, their browser
# shows a "your connection is not private" warning - click
# Advanced > Proceed (varies by browser). This is a one-time-per-browser
# click-through, not a bug.
JITSI_PUBLIC_URL=https://localhost:8443

# -----------------------------------------------------------------------
# VPS DEPLOYMENT: a real, trusted certificate (no browser warning), and
# actually reachable calls from other people's devices, need a domain.
#
# 1. Buy/use a domain (or free subdomain) and point a DNS A record at
#    your VPS's public IP - e.g. meet.yourdomain.com -> 203.0.113.10
# 2. Open ports 80 and 443 to the internet on the VPS firewall (Let's
#    Encrypt validates the domain over port 80; the meeting page and all
#    call traffic then run over 443)
# 3. Set these three, and change JITSI_PUBLIC_URL above to match:
#      ENABLE_LETSENCRYPT=1
#      LETSENCRYPT_DOMAIN=meet.yourdomain.com
#      LETSENCRYPT_EMAIL=you@example.com
#      JITSI_PUBLIC_URL=https://meet.yourdomain.com
# 4. Also set JITSI_HTTP_PORT=80 and JITSI_HTTPS_PORT=443 below (Let's
#    Encrypt's automated check expects the standard ports, not 8080/8443)
#
# Leave ENABLE_LETSENCRYPT=0 (the default) if you don't have a domain yet -
# self-signed still works, it just carries the one-time browser warning.
ENABLE_LETSENCRYPT=0
LETSENCRYPT_DOMAIN=
LETSENCRYPT_EMAIL=

# JVB (the videobridge) advertises THIS address to every participant's
# browser as where to actually send/receive audio/video. Same rule as
# above: 127.0.0.1 only works when everyone is on this one machine. For
# real cross-device calls, set this to your machine's real LAN IP too.
DOCKER_HOST_ADDRESS=127.0.0.1

# Host ports Jitsi's containers publish. Change these if something else
# on your machine is already using them.
#
# WINDOWS-SPECIFIC GOTCHA, FOUND WHILE TESTING THIS ON WINDOWS: Windows
# reserves ranges of ports for its own internal use (Hyper-V, WSL) that
# Docker simply can't bind to - trying gives an error like "bind: An
# attempt was made to access a socket in a way forbidden by its access
# permissions", which has NOTHING to do with this project's config. Port
# 4443 (a common Jitsi default elsewhere) falls inside one of these
# ranges on many Windows machines - 5443 below avoids it. If you hit that
# exact error on a different port, check your own machine's reserved
# ranges with (PowerShell): netsh interface ipv4 show excludedportrange
# protocol=tcp - then pick a port outside all the ranges it lists.
JITSI_HTTP_PORT=8080
JITSI_HTTPS_PORT=8443
JVB_PORT=10000
JVB_TCP_PORT=5443

TZ=UTC
