[Unit]
Description=GlobeTrotter Recommendation Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/globetrotter-backend/services/recommendation-service
EnvironmentFile=/root/globetrotter-backend/.env
Environment=USER_SERVICE_URL=http://127.0.0.1:8101
Environment=ITINERARY_SERVICE_URL=http://127.0.0.1:8102
ExecStart=/root/globetrotter-backend/services/recommendation-service/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8103
Restart=on-failure

[Install]
WantedBy=multi-user.target
