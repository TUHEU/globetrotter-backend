[Unit]
Description=GlobeTrotter User Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/globetrotter-backend/services/user-service
EnvironmentFile=/root/globetrotter-backend/.env
ExecStart=/root/globetrotter-backend/services/user-service/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8101
Restart=on-failure

[Install]
WantedBy=multi-user.target
